{
  "kind": "collectionType",
  "collectionName": "short_courses",
  "info": {
    "singularName": "short-course",
    "pluralName": "short-courses",
    "displayName": "Short Course"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "summary": {
      "type": "text"
    },
    "description": {
      "type": "blocks"
    },
    "education_levels": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::education-level.education-level",
      "inversedBy": "short_courses"
    },
    "duration": {
      "type": "string"
    },
    "bannerImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "LucideIcon": {
      "type": "component",
      "component": "shared.icons",
      "repeatable": false
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "short_courses"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "themeColor": {
      "type": "customField",
      "customField": "plugin::color-picker.color",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
    }
  }
}
